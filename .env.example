# Copy this file to .env and fill in your key. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# (setup_project.py does this for you.)

# Gemini model used by the agent (ADK native Gemini model name).
# Read from the environment by agents/inventory_agent/config.py; never hard-code it.
MODEL_NAME=gemini-3.5-flash

# Google AI Studio API key (starts with "AIza"). Required.
GOOGLE_API_KEY=

# Use the Gemini API (AI Studio) rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Optional: name written in the `performed_by` field of every stock movement.
INVENTORY_OPERATOR_NAME=Inventory Operator

# Optional: folder holding the inventory JSON files. Defaults to ./data in the project root.
# Tests point this at a temporary copy so they never change the real data.
# INVENTORY_DATA_DIR=
